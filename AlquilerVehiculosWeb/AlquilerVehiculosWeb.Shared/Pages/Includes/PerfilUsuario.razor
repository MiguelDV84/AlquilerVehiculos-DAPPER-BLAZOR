@page "/perfil"
@using WebApiNet.Shared.DTOs.Auth
@using WebApiNet.Shared.DTOs.Common
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject HttpClient Http

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                @* CABECERA DECORATIVA *@
                <div class="profile-header">
                    <div class="text-center pt-4">
                        <div class="avatar-circle shadow">
                            <i class="bi bi-person-fill text-white"></i>
                        </div>
                        <h4 class="text-white mt-3 mb-0 fw-bold">@userResponse?.Nombre</h4>
                        <p class="text-white-50 small">Cliente VIP RentDrive</p>
                    </div>
                </div>

                <div class="card-body p-4">
                    @if (userResponse == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-3 text-muted">Sincronizando con la central...</p>
                        </div>
                    }
                    else
                    {
                        <div class="profile-info-grid">
                            @* DNI *@
                            <div class="info-item d-flex align-items-center mb-4">
                                <div class="icon-box me-3">
                                    <i class="bi bi-card-text text-primary"></i>
                                </div>
                                <div>
                                    <label class="text-muted small d-block">Identificación (DNI)</label>
                                    <span class="fw-bold fs-5">@userResponse.Dni</span>
                                </div>
                            </div>

                            @* EMAIL *@
                            <div class="info-item d-flex align-items-center mb-4">
                                <div class="icon-box me-3">
                                    <i class="bi bi-envelope-at text-primary"></i>
                                </div>
                                <div>
                                    <label class="text-muted small d-block">Correo Electrónico</label>
                                    <span class="fw-bold fs-5">@userResponse.Email</span>
                                </div>
                            </div>

                            @* ESTADO DE CUENTA (Extra visual) *@
                            <div class="info-item d-flex align-items-center mb-4">
                                <div class="icon-box me-3">
                                    <i class="bi bi-shield-check text-success"></i>
                                </div>
                                <div>
                                    <label class="text-muted small d-block">Estado de Cuenta</label>
                                    <span class="badge bg-success-subtle text-success rounded-pill">Verificada</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-dark btn-lg rounded-3 shadow-sm" @onclick="Volver">
                                <i class="bi bi-arrow-left me-2"></i>Volver al Catálogo
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
        @if (listadoAlquiler == null)
        {
            <p>Cargando tus alquileres...</p>
        }
        else if (!listadoAlquiler.Any())
        {
            <div class="alert alert-info">Aún no tienes alquileres registrados.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var alquiler in listadoAlquiler)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold"><i class="bi bi-car-front"></i> @alquiler.VehiculoMatricula </span>
                                <span class="badge bg-success">@alquiler.Precio.ToString("N2")€</span>
                            </div>
                            <div class="card-body">
                                <p class="card-text"><strong>Inicio:</strong> @alquiler.FechaAlquiler</p>
                                <p class="card-text"><strong>Prevista:</strong> @alquiler.FechaDevolucionPrevista</p>
                                @if (alquiler.FechaDevolucionReal.HasValue)
                                {
                                    <p class="card-text text-success"><strong>Finalizado:</strong> @alquiler.FechaDevolucionReal.Value</p>
                                }
                                else
                                {
                                    <p class="card-text text-warning"><strong>Estado:</strong> Activo</p>
                                }

                            </div>
                            <button type="button" class="btn btn-outline-info btn-sm" @onclick="LlevarAlquiler">
                                <i class="bi bi-arrow-right me-2"></i>Volver al Alquiler
                            </button>
                        </div>
                    </div>
                }
            </div>   
        }
    </div>
</div>

